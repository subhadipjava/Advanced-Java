<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         version="6.1">

    <!-- Add Employee -->
    <servlet>
        <servlet-name>AddEmployee</servlet-name>
        <servlet-class>AddEmployee</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AddEmployee</servlet-name>
        <url-pattern>/AddEmployee</url-pattern>
    </servlet-mapping>


    <!-- View Employee -->
    <servlet>
        <servlet-name>ViewEmployee</servlet-name>
        <servlet-class>ViewEmployee</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>ViewEmployee</servlet-name>
        <url-pattern>/ViewEmployee</url-pattern>
    </servlet-mapping>


    <!-- Update Employee -->
    <servlet>
        <servlet-name>UpdateEmployee</servlet-name>
        <servlet-class>UpdateEmployee</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>UpdateEmployee</servlet-name>
        <url-pattern>/UpdateEmployee</url-pattern>
    </servlet-mapping>


    <!-- Delete Employee -->
    <servlet>
        <servlet-name>DeleteEmployee</servlet-name>
        <servlet-class>DeleteEmployee</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>DeleteEmployee</servlet-name>
        <url-pattern>/DeleteEmployee</url-pattern>
    </servlet-mapping>

</web-app>